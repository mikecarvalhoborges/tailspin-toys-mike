---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
          <p class="mt-1 text-sm text-slate-400" id="filter-results" aria-live="polite" data-testid="filter-results">
            Showing all {games.length} {games.length === 1 ? 'game' : 'games'}
          </p>
        </div>
      </div>

      <form method="get" action="/" class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
        <fieldset>
          <legend class="text-lg font-semibold text-slate-100">Filter games</legend>
          <div class="mt-4 grid gap-6 md:grid-cols-[2fr_1fr]">
            <div>
              <span class="text-sm font-medium text-slate-300">Categories</span>
              <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3" data-testid="category-filters">
                {categories.map((category) => (
                  <label class="flex items-center gap-2 text-sm text-slate-300">
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                      data-testid={`category-filter-${category.id}`}
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </div>

            <label class="text-sm font-medium text-slate-300" for="publisher-filter">
              Publisher
              <select
                id="publisher-filter"
                name="publisher"
                class="mt-3 block w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
              </select>
            </label>
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <button
              type="submit"
              class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="apply-filters"
            >
              Apply filters
            </button>
            <a
              href="/"
              class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="reset-filters"
            >
              Clear filters
            </a>
          </div>
        </fieldset>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => (
              <div
                data-game-category-id={game.category?.id}
                data-game-publisher-id={game.publisher?.id}
                data-filterable-game
              >
                <GameCard game={game} />
              </div>
            ))}
          </div>
          <p class="hidden rounded-xl border border-slate-700 bg-slate-800/60 p-6 text-center text-slate-300" data-testid="no-filter-results">
            No games match the selected filters.
          </p>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const resultSummary = document.querySelector<HTMLElement>('#filter-results');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-filterable-game]'));
  const emptyResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');

  if (form && resultSummary && emptyResults) {
    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    const selectedPublisher = params.get('publisher') ?? '';
    const categoryInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisherInput = form.querySelector<HTMLSelectElement>('select[name="publisher"]');

    categoryInputs.forEach((input) => {
      input.checked = selectedCategories.has(input.value);
    });
    if (publisherInput) {
      publisherInput.value = selectedPublisher;
    }

    const matchingCards = gameCards.filter((card) => {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.gameCategoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' || card.dataset.gamePublisherId === selectedPublisher;
      return categoryMatches && publisherMatches;
    });

    gameCards.forEach((card) => {
      card.hidden = !matchingCards.includes(card);
    });
    emptyResults.hidden = matchingCards.length !== 0;

    const hasFilters = selectedCategories.size > 0 || selectedPublisher !== '';
    resultSummary.textContent = hasFilters
      ? `Showing ${matchingCards.length} ${matchingCards.length === 1 ? 'game' : 'games'}`
      : `Showing all ${gameCards.length} ${gameCards.length === 1 ? 'game' : 'games'}`;
  }
</script>
